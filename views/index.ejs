<% const pad = (n) => String(n).padStart(2, "0"); %>

<section class="hero">
    <div class="title-section" data-aos="fade-up">
        <h1 class="shine"><%= t("hero.title") %></h1>
        <div class="experience">
            <p><%- t("hero.experience") %></p>
        </div>
    </div>

    <div class="bio-section" data-aos="fade-up">
        <p class="bio"><%- t("hero.bio") %></p>
    </div>

    <a href="#about" class="scroll-down" aria-label="<%= t("hero.scroll") %>" data-aos="fade-up"></a>

    <img class="absolute_img" src="/images/photo.jpg" alt="Luis Bossa" fetchpriority="high">
</section>


<section id="services" class="services_section">
    <div class="services_header">
        <div>
            <span class="section-label"><%= t("services.label") %></span>
            <h2 class="services_title" data-aos="fade-up"><%= t("services.title") %></h2>
        </div>
        <p class="services_intro"><%= t("services.intro") %></p>
    </div>

    <div class="services_wrap">
        <% t("services.items").forEach((service, i) => { %>
        <div class="service service_<%= i + 1 %>" data-aos="fade-up"<% if (i) { %> data-aos-delay="<%= i * 100 %>"<% } %>>
            <div class="service-top">
                <span class="service-icon">
                    <%- include(`partials/icons/service-${i + 1}`) %>
                </span>
                <span class="service-index"><%= pad(i + 1) %></span>
            </div>
            <h2><%= service.title %></h2>
            <p><%= service.text %></p>
            <ul class="service-tags">
                <% service.tags.forEach((tag) => { %>
                <li><%= tag %></li>
                <% }) %>
            </ul>
        </div>
        <% }) %>
    </div>
</section>

<section id="about" class="about-section">
    <div class="about-header">
        <div>
            <span class="section-label"><%= t("about.label") %></span>
            <h2 class="about-title" data-aos="fade-up"><%= t("about.title") %></h2>
        </div>
        <p class="about-header-intro"><%= t("about.intro") %></p>
    </div>

    <div class="bento-grid">
        <!-- PRESENTACIÓN -->
        <article class="card about-main" data-aos="fade-up">
            <span class="about-kicker"><%= t("about.kicker") %></span>
            <h3 class="about-statement"><%= t("about.statement") %></h3>
            <p class="about-text"><%= t("about.text") %></p>

            <ul class="about-facts">
                <li><strong>+4</strong><span><%= t("about.facts.years") %></span></li>
                <li><strong><%= projects.length %></strong><span><%= t("about.facts.projects") %></span></li>
                <li><strong>CR</strong><span><%= t("about.facts.location") %></span></li>
            </ul>

            <div class="about-profile">
                <img src="/images/profile.jpeg" class="about-avatar" alt="Luis Bossa" loading="lazy" />
                <div class="about-profile-text">
                    <strong>Luis Bossa</strong>
                    <span><%= t("about.role") %></span>
                </div>
                <a href="https://www.linkedin.com/in/luis-bossa-medina-0a2334270/" target="_blank" rel="noreferrer"
                    class="about-linkedin" aria-label="<%= t("about.linkedinLabel") %>">
                    <i class="bx bxl-linkedin"></i> LinkedIn
                </a>
            </div>
        </article>

        <!-- CREATIVIDAD -->
        <article class="card about-habit" data-aos="fade-up" data-aos-delay="100">
            <span class="about-icon"><i class="bx bx-dumbbell"></i></span>
            <h3 class="about-card-title"><%= t("about.creativityTitle") %></h3>
            <p class="about-text"><%- t("about.creativityText") %></p>
        </article>

        <!-- CONTACTO -->
        <article class="card about-connect" data-aos="fade-up" data-aos-delay="200">
            <span class="about-icon"><i class="bx bx-conversation"></i></span>
            <h3 class="about-card-title"><%= t("about.connectTitle") %></h3>
            <p class="about-text"><%= t("about.connectText") %></p>
            <a class="btn" href="#contact">
                <i class="bx bx-send"></i> <%= t("about.contactMe") %>
            </a>
        </article>

        <!-- HERRAMIENTAS -->
        <article class="card about-toolbox" data-aos="fade-up" data-aos-delay="300">
            <img src="/images/skills-group.png" alt="" class="skills-group" loading="lazy">
            <h3 class="about-card-title"><%= t("about.toolboxTitle") %></h3>
            <dl class="toolbox-list">
                <% t("about.toolbox").forEach(([group, tools]) => { %>
                <div class="toolbox-row">
                    <dt><%= group %></dt>
                    <dd>
                        <% tools.split(", ").forEach((tool) => { %>
                        <span class="toolbox-chip"><%= tool %></span>
                        <% }) %>
                    </dd>
                </div>
                <% }) %>
            </dl>
        </article>
    </div>
</section>

<section id="resume" class="exp_section">
    <input type="radio" name="tab" id="tab1" class="tab-input" checked>
    <input type="radio" name="tab" id="tab2" class="tab-input">

    <div class="exp_header">
        <div>
            <span class="section-label"><%= t("resume.label") %></span>
            <h2 class="exp_title" data-aos="fade-up"><%= t("resume.title") %></h2>
        </div>

        <div class="radio_wrap">
            <span class="tab-indicator" aria-hidden="true"></span>
            <label for="tab1" class="tab-label active">
                <%= t("resume.education") %> <span class="tab-count"><%= pad(t("resume.educationItems").length) %></span>
            </label>
            <label for="tab2" class="tab-label">
                <%= t("resume.experience") %> <span class="tab-count"><%= pad(t("resume.experienceItems").length) %></span>
            </label>
        </div>
    </div>

    <div class="tabs" data-aos="fade-up">
        <% [["education", "resume.educationItems"], ["experience", "resume.experienceItems"]].forEach(([id, key], tab) => { %>
        <div class="tab-content<%= tab ? "" : " active" %>" id="<%= id %>">
            <ol class="timeline">
                <% t(key).forEach((item) => { %>
                <li class="timeline-item">
                    <span class="timeline-date"><%= item.date %></span>
                    <div class="timeline-body">
                        <h3><%= item.title %></h3>
                        <% if (item.org) { %>
                        <p class="timeline-org"><%= item.org %></p>
                        <% } %>
                        <p><%= item.text %></p>
                    </div>
                </li>
                <% }) %>
            </ol>
        </div>
        <% }) %>
    </div>
</section>

<% const skills = ["HTML", "CSS", "JavaScript", "TypeScript", "React", "Next.js", "Node.js", "Express", "Laravel", "Tailwind", "Sass", "WordPress", "Webflow", "Figma"]; %>
<div class="skills-band" aria-label="<%= t("skills") %>">
    <% [false, true].forEach((hidden) => { %>
    <ul class="skills-track"<% if (hidden) { %> aria-hidden="true"<% } %>>
        <% skills.forEach((skill) => { %><li><%= skill %></li><% }) %>
    </ul>
    <% }) %>
</div>

<section id="portfolio" class="projects-section">
    <span class="section-label"><%= t("portfolio.label") %></span>
    <h3 data-aos="fade-up"><%= t("portfolio.title") %></h3>

    <div class="carousel" data-carousel>
        <div class="carousel-track" tabindex="0" aria-label="<%= t("portfolio.carousel") %>" aria-roledescription="carousel">
            <% projects.forEach((project) => { %>
            <%- include("partials/project-card", { project, total: projects.length }) %>
            <% }) %>
        </div>

        <div class="carousel-controls">
            <span class="carousel-count">
                <span data-current>01</span> / <%= pad(projects.length) %>
            </span>
            <div class="carousel-progress" aria-hidden="true"><span></span></div>
            <div class="carousel-buttons">
                <button type="button" class="carousel-btn" data-prev aria-label="<%= t("portfolio.previous") %>">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                        <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6"
                            stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <button type="button" class="carousel-btn" data-next aria-label="<%= t("portfolio.next") %>">
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                        <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6"
                            stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- CONTACT SECTION -->
<section id="contact" class="contact-section">
    <div class="contact-header" data-aos="fade-up">
        <span class="section-label"><%= t("contact.label") %></span>
        <h3><%= t("contact.title") %></h3>
        <p><%= t("contact.intro") %></p>
    </div>

    <div class="contact-grid" data-aos="fade-up">
        <aside class="contact-info">
            <h4 class="contact-title"><%= t("contact.infoTitle") %></h4>
            <p class="contact-intro"><%= t("contact.infoIntro") %></p>

            <ul class="contact-list">
                <li class="contact-row">
                    <a href="mailto:lebossamedina@gmail.com" class="contact-link">
                        <span class="contact-icon"><i class="bx bx-envelope"></i></span>
                        <span class="contact-text">
                            <span class="contact-label"><%= t("contact.email") %></span>
                            <span class="contact-value">lebossamedina@<wbr>gmail.com</span>
                        </span>
                        <i class="bx bx-right-arrow-alt contact-arrow"></i>
                    </a>
                    <button type="button" class="contact-copy" data-copy="lebossamedina@gmail.com"
                        aria-label="<%= t("contact.copyLabel") %>">
                        <i class="bx bx-copy"></i><span><%= t("contact.copy") %></span>
                    </button>
                </li>
                <li class="contact-row">
                    <a href="tel:+50664145674" class="contact-link">
                        <span class="contact-icon"><i class="bx bx-phone"></i></span>
                        <span class="contact-text">
                            <span class="contact-label"><%= t("contact.phone") %></span>
                            <span class="contact-value">+(506) 6414-5674</span>
                        </span>
                        <i class="bx bx-right-arrow-alt contact-arrow"></i>
                    </a>
                </li>
                <li class="contact-row">
                    <a href="https://maps.google.com/?q=San+Jos%C3%A9,+Costa+Rica" class="contact-link" target="_blank" rel="noreferrer">
                        <span class="contact-icon"><i class="bx bx-map"></i></span>
                        <span class="contact-text">
                            <span class="contact-label"><%= t("contact.location") %></span>
                            <span class="contact-value">San José, Costa Rica</span>
                        </span>
                        <i class="bx bx-right-arrow-alt contact-arrow"></i>
                    </a>
                </li>
            </ul>

            <div class="contact-social">
                <span class="contact-label"><%= t("contact.findMe") %></span>
                <div class="contact-social-links">
                    <a href="https://github.com/luisbossa" target="_blank" rel="noreferrer"><i class="bx bxl-github"></i> GitHub</a>
                    <a href="https://www.linkedin.com/in/luis-bossa-medina-0a2334270/" target="_blank" rel="noreferrer"><i class="bx bxl-linkedin"></i> LinkedIn</a>
                    <a href="https://wa.me/50664145674" target="_blank" rel="noreferrer"><i class="bx bxl-whatsapp"></i> WhatsApp</a>
                </div>
            </div>
        </aside>

        <div class="contact-form-wrap">
            <h4 class="contact-title"><%= t("contact.formTitle") %></h4>

            <form id="contactForm" novalidate>
                <div class="form-row">
                    <div class="form-group">
                        <label for="name" class="form-label"><%= t("contact.name") %></label>
                        <input type="text" id="name" name="name" placeholder="<%= t("contact.namePlaceholder") %>"
                            autocomplete="name" class="form-control">
                        <span class="error-message" id="errorName"></span>
                    </div>

                    <div class="form-group">
                        <label for="email" class="form-label"><%= t("contact.email") %></label>
                        <input type="email" id="email" name="email" placeholder="<%= t("contact.emailPlaceholder") %>"
                            autocomplete="email" class="form-control">
                        <span class="error-message" id="errorEmail"></span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="form-label-row">
                        <label for="message" class="form-label"><%= t("contact.message") %></label>
                        <span class="char-count" aria-live="polite"><span data-count>0</span> / 1000</span>
                    </div>
                    <textarea name="message" id="message" maxlength="1000"
                        placeholder="<%= t("contact.messagePlaceholder") %>" class="form-control"></textarea>
                    <span class="error-message" id="errorMessage"></span>
                </div>

                <div class="form-footer">
                    <p class="form-note"><i class="bx bx-lock-alt"></i> <%= t("contact.note") %></p>
                    <button type="submit" id="submitBtn" class="message-btn">
                        <span id="btnText"><%= t("contact.send") %> <i class="bx bx-send"></i></span>
                        <span id="loadingSpinner" class="spinner"></span>
                    </button>
                </div>

                <div class="success-message" id="successMessage" role="status" aria-live="polite"></div>
            </form>
        </div>
    </div>
</section>

<script src="/js/contact-form.js"></script>
