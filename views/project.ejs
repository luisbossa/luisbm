<% const pad = (n) => String(n).padStart(2, "0"); %>

<article class="case">
    <!-- NAVEGACIÓN SUPERIOR -->
    <nav class="case-topbar" aria-label="<%= t("project.allProjects") %>">
        <a href="/#portfolio" class="case-back">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6"
                    stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <%= t("project.allProjects") %>
        </a>
        <span class="case-counter"><%= pad(project.id) %> / <%= pad(total) %></span>
    </nav>

    <!-- PORTADA -->
    <div class="case-hero">
        <span class="section-label"><%= t("project.caseStudy") %> &mdash; <%= year %></span>
        <h1 class="case-title"><%= project.title %></h1>
        <p class="case-lead"><%= project.description %></p>

        <div class="case-actions">
            <a href="<%= project.demoUrl %>" class="project-btn" target="_blank" rel="noreferrer">
                <%= t("project.viewDemo") %>
            </a>
            <a href="<%= project.codeUrl %>" class="case-link" target="_blank" rel="noreferrer">
                <%= t("project.viewCode") %>
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                    <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="1.6"
                        stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
        </div>
    </div>

    <!-- DATOS CLAVE -->
    <dl class="case-facts">
        <div>
            <dt><%= t("project.timeline") %></dt>
            <dd><%= startDate %> &ndash; <%= endDate %></dd>
        </div>
        <% if (duration) { %>
        <div>
            <dt><%= t("project.duration") %></dt>
            <dd><%= duration %></dd>
        </div>
        <% } %>
        <div>
            <dt><%= t("project.year") %></dt>
            <dd><%= year %></dd>
        </div>
        <div class="case-facts-stack">
            <dt><%= t("project.stack") %></dt>
            <dd>
                <% project.technologies.forEach((tech) => { %>
                <span class="project-pill"><%= tech %></span>
                <% }) %>
            </dd>
        </div>
    </dl>

    <div class="case-body">
        <!-- CAPTURA EN UNA VENTANA DE NAVEGADOR -->
        <figure class="browser">
            <div class="browser-bar">
                <span class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                <a href="<%= project.demoUrl %>" class="browser-url" target="_blank" rel="noreferrer">
                    <%= domain %>
                </a>
            </div>
            <div class="browser-view">
                <img src="<%= project.image %>" alt="<%= project.imageAlt %>" class="project-preview-img"
                    onload="this.classList.add('loaded')" />
                <div class="skeleton"></div>
            </div>
            <figcaption><%= t("project.scrollHint") %></figcaption>
        </figure>

        <div class="case-content">
            <!-- FUNCIONALIDADES -->
            <section class="case-section">
                <h2 class="case-heading"><%= t("project.features") %></h2>
                <ol class="case-features">
                    <% project.features.forEach((feature, i) => { %>
                    <li>
                        <span class="case-feature-index"><%= pad(i + 1) %></span>
                        <%= feature %>
                    </li>
                    <% }) %>
                </ol>
            </section>

            <% [
                ["challenges", t("project.challenges")],
                ["performance", t("project.performance")],
                ["seo", t("project.seo")],
                ["roles", t("project.role")],
            ].forEach(([key, heading]) => { %>
            <section class="case-section">
                <h2 class="case-heading"><%= heading %></h2>
                <p><%= project[key] %></p>
            </section>
            <% }) %>
        </div>
    </div>

    <!-- ANTERIOR / SIGUIENTE -->
    <nav class="case-pager" aria-label="<%= t("project.moreProjects") %>">
        <a href="/project<%= prev.id %>" class="case-pager-link">
            <img src="<%= prev.card.poster %>" alt="" loading="lazy">
            <span class="case-pager-text">
                <span class="case-pager-label">&larr; <%= t("project.previous") %></span>
                <span class="case-pager-title"><%= prev.title %></span>
            </span>
        </a>
        <a href="/project<%= next.id %>" class="case-pager-link case-pager-next">
            <img src="<%= next.card.poster %>" alt="" loading="lazy">
            <span class="case-pager-text">
                <span class="case-pager-label"><%= t("project.next") %> &rarr;</span>
                <span class="case-pager-title"><%= next.title %></span>
            </span>
        </a>
    </nav>
</article>
